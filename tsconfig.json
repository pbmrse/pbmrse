{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "test",
    "scripts",
    "hardhat.config.ts",
    "worker-configuration.d.ts",
    "custom-worker.ts",
    "treasury-signer-configuration.d.ts",
    "treasury-signer-worker.ts",
    "reward-signer-configuration.d.ts",
    "reward-signer-worker.ts",
    "custody-signer-configuration.d.ts",
    "custody-signer-worker.ts",
    "src/lib/bank-admin.ts",
    "src/lib/bank-payouts.ts",
    "src/lib/bank-operations.ts",
    "src/lib/bank-maintenance.ts",
    "src/lib/mining-settlement.ts",
    "src/lib/mining-purchase.ts",
    "src/lib/reward-claims.ts",
    "src/lib/site-swap.ts",
    "src/lib/bank-deposits.ts"
  ]
}
